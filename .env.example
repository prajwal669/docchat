# Copy to .env and export, or pass with `docker run --env-file .env`. Every value is optional.

# Set this to get written, cited answers from Claude. Without it the app uses the offline extractive answerer.
ANTHROPIC_API_KEY=

# RAG_LLM_MODEL=claude-sonnet-5-5
# RAG_RETRIEVER=hybrid          # bm25 | tfidf | lsa | hybrid  (dense | hybrid_dense with fastembed installed)
# RAG_CHUNKER=sentence          # sentence | fixed
# RAG_CHUNK_SIZE=100
# RAG_TOP_K=4
# RAG_MIN_COVERAGE=0.2          # refuse questions whose best passage covers less than this share of the query
# RAG_RANK_DECAY=0.6
# RAG_MAX_UPLOAD_MB=20
# RAG_STORAGE_DIR=storage
# RAG_DEMO_MODE=1               # read-only public demo: sample documents only, no uploads, offline answers

# Public demo uploads: shared in-memory library; never use for private documents.
# RAG_PUBLIC_UPLOADS=1
